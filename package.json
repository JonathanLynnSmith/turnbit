{
  "name": "desktop-ulanzi-ipod-poc",
  "version": "0.2.0",
  "author": "turnbit contributors",
  "license": "MIT",
  "private": true,
  "description": "Desktop Spotify controller for Electron + Ulanzi D100H",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "lint": "eslint src renderer scripts test ulanzi-plugin/com.turnbit.spotify.ulanziPlugin/app.js",
    "test": "node --test",
    "check": "npm run lint && npm test",
    "plugin:build": "node scripts/build-plugin.js",
    "plugin:install": "node scripts/install-plugin.js",
    "studio:restart": "node scripts/restart-studio.js",
    "package": "electron-builder --dir",
    "demo:gif": "electron scripts/make-demo-gif.js",
    "test:playback": "electron scripts/verify-playback-service.js",
    "test:desktop": "electron scripts/verify-window-mode.js && electron scripts/verify-now-playing-backdrop.js",
    "format": "prettier --write \"src/**/*.js\" \"renderer/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"renderer/**/*.{js,mjs}\"",
    "test:navigation": "electron scripts/verify-navigation-performance.js",
    "smoke": "electron scripts/smoke.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "gifenc": "^1.0.3",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.turnbit.app",
    "productName": "turnbit",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "ulanzi-plugin/**/*",
      "package.json",
      "assets/branding/**/*"
    ],
    "asarUnpack": [
      "src/media-session-helper.ps1"
    ],
    "icon": "assets/branding/turnbit.ico",
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/branding/turnbit-512.png",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "turnbit controls the Spotify app on this Mac so play, pause, skip, and seek respond instantly."
      }
    },
    "win": {
      "icon": "assets/branding/turnbit.ico"
    }
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "electron-winstaller@5.4.0": true
  }
}
